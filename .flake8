# Repo-level flake8 config.
#
# The pre-commit flake8 hook lints WHOLE staged files (no --diff), and it runs
# isort + yapf FIRST (auto-fixing whitespace/blank-line codes). The residual
# violations below are PRE-EXISTING debt at HEAD that survives that formatting
# pass. They are suppressed per-file so the hook can gate new code strictly
# without failing on legacy debt. Do NOT add blanket/global ignores: new files
# remain fully linted (a file not listed here gets zero extra ignores).
[flake8]
max-line-length = 300
extend-ignore = E231, E702, E251, W604
per-file-ignores =
    agent_cascade/api_router_pkg/router.py: E225, F401
    agent_cascade/engine/core.py: E402, F401, F541
    agent_cascade/engine/llm_call.py: E129, E225, E402, E713, F401, F841
    agent_cascade/agent_instance.py: F402, F821
    agent_cascade/api_integration_pkg/state_builder.py: E122, E124, E402
    agent_cascade/api_integration_pkg/streaming.py: E129, F824
    agent_cascade/api_router_pkg/endpoints.py: E302, E305
    agent_cascade/api_router_pkg/normalization.py: E302
    agent_cascade/api_server.py: E111, E117, E303, E306, E501, F811, F824
    agent_cascade/async_shell_pkg/task.py: E302
    agent_cascade/async_shell_pkg/tracker.py: E741
