{
  "blender": {
    "command": "uvx",
    "args": [
      "--python",
      "3.11",
      "mcp-for-blender"
    ],
    "env": {
      "UV_PYTHON_PREFERENCE": "only-managed",
      "BLENDER_HOST": "localhost",
      "BLENDER_PORT": "9876",
      "BLENDER_MCP_SAFE_MODE": "1"
    },
    "enabled": false
  },
  "chrome-devtools": {
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest"
    ],
    "enabled": false
  }
}
