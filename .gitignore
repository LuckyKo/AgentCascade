# Temporary directory
temp/

# Logs
logs/

# API configs (contain secrets)
config/api_endpoints.json
config/api_endpoints.json.bak
config/api_endpoints.zip
config/secrets.json

# Investigation probe configs (local scratch, e.g. BUG_0310 endpoint probes — not shared)
config/*probe*.json

# Pool settings (runtime-generated, user-specific)
config/pool_settings*.json

# MCP server config (user-local: per-machine enabled servers)
config/mcp_servers.json

# MCP tool-metadata cache (runtime-generated by lazy connect; _load_tools_cache tolerates a
# missing file, so it is local-only. Schema seed: config/mcp_tools_cache.example.json.)
config/mcp_tools_cache.json

# Session state (runtime-generated, user-specific)
config/session_state.json
config/session_state.json.bak

# Agent lessons
.agent_lessons/

# Bug tracking
.bug_tracker/

# Local todo list (personal, not shared)
todo.md

# Temp planning docs (local working notes, not shared)
plans/

# Research & investigation reports (local working docs, not shared)
research/
reports/

# Playback data (large JSONL files)
playback/

# Windows reserved names / special files
nul
$null

# Inactive skill archive (do not track)
agents/global/skills/INACTIVE/

# Skill candidates (pending review, not yet promoted)
agents/global/candidates/

# Skill usage metrics (runtime-generated: load counts, ratings)
agents/global/skills-metrics.json

# New auto-generated skills (do not track). Base skills already committed stay
# tracked — gitignore only affects untracked files, so this blocks NEW skills
# under agents/global/skills/ without touching the existing tracked base skills.
agents/global/skills/

# Backup files (editor/tool .bak artifacts — do not track)
*.bak

# xdist worker crash dumps (faulthandler diagnostics, see tests/conftest.py)
tests/_crash_dumps/

# BUG_0357 per-worker xdist crash capture dir (sitecustomize vector; evidence logs)
tmp_ac_iso/

# git filter-branch / filter-repo scratch dir (accidentally committed; do not track)
.git-rewrite/

# Model cache (large local downloads)
model_cache/

# pytest parallel-case scratch dirs + captured test output (runtime artifacts)
tests/_tmp_p_case*/
tests/_test_output*

# Per-instance test log dirs created by instance_id.make_instance_dir
# (logs_<AGENT_CASCADE_INSTANCE_ID>) during xdist/serial test runs. Untracked artifacts.
logs_test_*/

# machine-local, untracked (rewritten with absolute paths by POST /api/media_gen)
config/media_gen/media_gen.json

# Timestamped runtime settings dumps (same family as pool_settings/secrets)
config/agent-cascade-settings-*.json

# Chatterbox-TTS-Server local config (dominated by runtime ui_state, not shared)
/config.yaml
