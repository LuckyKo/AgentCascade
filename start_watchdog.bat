@echo off
setlocal EnableExtensions
REM =====================================================================
REM  start_watchdog.bat -- BUG_0353 self-recovery watchdog
REM
REM  Supervises the AC server so a clean external kill (console-window
REM  close / taskkill / unhandled exception -- see BUG_0353) self-recovers
REM  in ~5s and leaves a diagnosable trace:
REM    - server stderr -> logs\server_stderr.log  (the crash signature)
REM    - each restart  -> logs\watchdog.log       (timestamped [WATCHDOG] line)
REM
REM  RULES
REM   1. This watchdog is the SINGLE owner of port 8126. Do NOT run a
REM      separate manual start.bat alongside it. Before each launch the
REM      watchdog kills any stale listener on the port, so a stray
REM      instance cannot wedge it into a crash-loop.
REM   2. While this watchdog owns the server, do NOT trigger the in-code
REM      restart (trigger_restart.py) -- it re-execs a fresh instance that
REM      would collide with the watchdog's next launch.
REM   3. Do NOT edit this file while the watchdog is running. cmd.exe
REM      re-reads a .bat mid-execution and executes the new content
REM      (including the taskkill below) on the next loop tick. Kill the
REM      watchdog first, edit, then relaunch.
REM =====================================================================

cd /d %~dp0
set "PORT=8126"
set "WLOG=logs\watchdog.log"
set "SLOG=logs\server_stderr.log"
if not exist logs mkdir logs

echo [%date% %time%] [WATCHDOG] watchdog started (port %PORT%, cwd=%cd%) >> "%WLOG%"

:loop
REM --- single-owner guard: kill any stale listener on PORT (prevents the
REM     crash-loop where a stray/manual instance already holds the port) ---
for /f "tokens=5" %%p in ('netstat -ano ^| findstr "LISTENING" ^| findstr ":%PORT%"') do (
    taskkill /f /pid %%p >nul 2>&1
)
timeout /t 1 /nobreak >nul

REM --- launch; start.bat captures server stderr to SLOG (append) ---
call start.bat

REM --- server exited: log the event (timestamp + exit code), then restart ---
echo [%date% %time%] [WATCHDOG] server exited (code %errorlevel%) - restarting in 5s >> "%WLOG%"
timeout /t 5 /nobreak >nul
goto loop
